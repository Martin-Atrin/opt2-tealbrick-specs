{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tealbrick.com/opt2/contracts/fleet.directory_feed/1.schema.json",
  "title": "fleet.directory_feed/1 — Governance directory feed for app readers (Rules)",
  "description": "v0.1.41 (C230, G-3, RUL-02, FLT-02). Producer: fleet (Governance) op directory_feed. Consumer: rules. Readers validate the answer against this schema; a mismatch is a refusal with an error (never a partial read). Extra members are allowed and ignored (L24); required members and enum values are strict. Handles are canonical (@opt2-tealbrick/manifest normalizeHandle, G-4). Answers carry no email, no Connect identities and no review reasons (C88, FLT-01).",
  "oneOf": [{ "$ref": "#/$defs/full" }, { "$ref": "#/$defs/unchanged" }],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "trust": { "enum": ["unreviewed", "trusted", "limited", "blocked"] },
    "handle": { "type": "string", "pattern": "^(buzz:npub1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{58}|slack:[UW][A-Z0-9]{2,30}|telegram:-?[1-9][0-9]{0,19})$" },
    "unchanged": {
      "type": "object",
      "required": ["v", "revision", "unchanged"],
      "properties": { "v": { "const": 1 }, "revision": { "type": "integer", "minimum": 0 }, "unchanged": { "const": true } }
    },
    "full": {
      "type": "object",
      "required": ["v", "revision", "teams", "contacts", "agents"],
      "properties": {
        "v": { "const": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "unchanged": { "const": false },
        "teams": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["id", "members"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "members": {
                "type": "array",
                "maxItems": 2000,
                "items": {
                  "type": "object",
                  "required": ["kind", "id"],
                  "properties": {
                    "kind": { "enum": ["agent", "contact"] },
                    "id": { "$ref": "#/$defs/id" },
                    "role": { "type": "string", "maxLength": 60 }
                  }
                }
              }
            }
          }
        },
        "contacts": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["id", "kind", "status", "trust", "handles"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["person", "outside_agent"] },
              "status": { "enum": ["active", "departed"] },
              "trust": { "$ref": "#/$defs/trust" },
              "handles": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/handle" } }
            }
          }
        },
        "agents": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["id", "status", "trust", "owner"],
            "properties": {
              "id": { "type": "string", "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$" },
              "status": { "enum": ["active", "removed"] },
              "trust": { "$ref": "#/$defs/trust" },
              "owner": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
            }
          }
        }
      }
    }
  }
}
