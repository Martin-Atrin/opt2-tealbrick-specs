{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.opt2.tealbrick.com/instance-slice.schema.json",
  "title": "Instance slice payload (tb-slice+jws)",
  "description": "v0.1. JWS payload of the per-instance slice: signed by Portal (or the standalone issuer), carried inside the workspace config, relayed to the app by the bridge via POST /tb/v1/status (BRIDGE.md §10.4). v0.1.11 (C62/C63): `portalKeySet` (root-signed key-set statement; apps verify slices against it, CREDENTIALS §9.5), `portalKeys` informational.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti",
    "ws",
    "rev",
    "ins",
    "product",
    "portalKeys",
    "bridge",
    "pause",
    "revoked",
    "personNbf",
    "grants",
    "agents"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "iss": {
      "anyOf": [
        {
          "const": "tb:portal"
        },
        {
          "$ref": "workspace-config.schema.json#/$defs/brgAudience"
        }
      ]
    },
    "sub": {
      "$ref": "workspace-config.schema.json#/$defs/insAudience"
    },
    "aud": {
      "$ref": "workspace-config.schema.json#/$defs/insAudience"
    },
    "iat": {
      "$ref": "workspace-config.schema.json#/$defs/epochSeconds"
    },
    "exp": {
      "$ref": "workspace-config.schema.json#/$defs/epochSeconds",
      "description": "iat + 12 h."
    },
    "jti": {
      "$ref": "workspace-config.schema.json#/$defs/ulid"
    },
    "ws": {
      "$ref": "workspace-config.schema.json#/$defs/wsId"
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic per instance."
    },
    "ins": {
      "$ref": "workspace-config.schema.json#/$defs/insId"
    },
    "product": {
      "$ref": "workspace-config.schema.json#/$defs/productId"
    },
    "portalKeys": {
      "$ref": "workspace-config.schema.json#/$defs/portalKeys"
    },
    "portalKeySet": {
      "$ref": "workspace-config.schema.json#/$defs/portalKeySet"
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "keys"
      ],
      "properties": {
        "id": {
          "$ref": "workspace-config.schema.json#/$defs/brgId"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "Keys the app accepts for call proofs (TB-Call).",
          "items": {
            "$ref": "workspace-config.schema.json#/$defs/ed25519Jwk"
          }
        },
        "publicUrl": {
          "$ref": "workspace-config.schema.json#/$defs/httpsUrl",
          "description": "v0.1.10 (C64): the bridge's public origin; apps build third-party callback URLs `<publicUrl>/p/<product><path>` from it (SDK OpContext.publicUrl). Core MUST emit it once the bridge's public URL is known."
        }
      }
    },
    "pause": {
      "$ref": "workspace-config.schema.json#/$defs/pause"
    },
    "revoked": {
      "$ref": "workspace-config.schema.json#/$defs/revoked"
    },
    "personNbf": {
      "$ref": "workspace-config.schema.json#/$defs/epochSeconds",
      "description": "App UI sessions created before this time are invalid."
    },
    "grants": {
      "type": "array",
      "maxItems": 64,
      "description": "Companion grants (K10) this instance presents as TB-Grant for manifest-declared app-to-app calls.",
      "items": {
        "$ref": "workspace-config.schema.json#/$defs/compactJws"
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 500,
      "description": "Agents with an edge to this app, or all agents when the manifest sets needsAgentDirectory.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mode",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "workspace-config.schema.json#/$defs/agtId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mode": {
            "$ref": "workspace-config.schema.json#/$defs/agentMode"
          },
          "status": {
            "enum": [
              "active",
              "paused"
            ]
          }
        }
      }
    },
    "standalone": {
      "$ref": "workspace-config.schema.json#/$defs/standaloneBlock"
    }
  }
}
